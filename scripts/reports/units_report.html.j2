byId("save-comments").addEventListener("click", async () => {
  if (byId("comment-text").value.trim()) {
    setStatus("Add the current comment before saving."); return;
  }
  const payload = JSON.stringify({document: "Units module analysis", revision: "A", comments}, null, 2) + "\n";
  try {
    if (window.showSaveFilePicker) {
      const handle = await window.showSaveFilePicker({suggestedName: commentFile, types: [{description: "Comment file", accept: {"application/json": [".json"]}}]});
      const writable = await handle.createWritable();
      await writable.write(payload);
      await writable.close();
      unsaved = false;
      setStatus("Comment file saved. Keep it beside the report.");
    } else {
      const url = URL.createObjectURL(new Blob([payload], {type: "application/json"}));
      const link = document.createElement("a");
      link.href = url; link.download = commentFile; link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      setStatus("Download offered. Save units-report.comments.json beside the report; disk saving has not been confirmed.");
    }
  } catch (error) {
    setStatus(error.name === "AbortError" ? "Saving cancelled; comments remain on this page." : "Saving failed; comments remain on this page.");
  }
});
byId("load-comments").addEventListener("change", async event => {
  const file = event.target.files[0];
  if (!file) return;
  if (unsaved || byId("comment-text").value.trim()) {
    setStatus("Save the current comments before loading another file."); return;
  }
  try {
    const loaded = JSON.parse(await file.text());
    if (loaded.document !== "Units module analysis" || loaded.revision !== "A" || !Array.isArray(loaded.comments) || !loaded.comments.every(item => item && typeof item.section === "string" && typeof item.text === "string")) {
      throw new Error("Invalid comment file");
    }
    comments.splice(0, comments.length, ...loaded.comments);
    renderComments();
    setStatus("Existing comments loaded. Save again after adding notes.");
  } catch (error) { setStatus("The selected file is not a comment file for this report revision."); }
});
document.querySelectorAll("[data-point]").forEach(point => {
  const show = () => {
    const sample = reportData.curve[Number(point.dataset.point)];
    byId("chart-detail").textContent = `Public guide illustration; loaded surface; area ${sample.area_m2.toFixed(1)} m²; demand ${sample.force_kn.toFixed(3)} kN; allowable load not supplied. Capacity is not evaluated.`;
  };
  point.addEventListener("mouseenter", show); point.addEventListener("focus", show);
});
window.addEventListener("beforeunload", event => {
  if (unsaved || byId("comment-text").value.trim()) { event.preventDefault(); event.returnValue = ""; }
});
</script>
</body>
</html>
