<script>
'use strict';
const reportData = JSON.parse(document.getElementById('report-data').textContent);
const reportDigest = '{{ report_id }}';
const comments = [];
function describePoint(index) {
  const row = reportData.rows[index];
  document.getElementById('chart-detail').textContent =
    `Case: combined illustration. Component: cost stream. Year: ${row.year}. Demand: ${row.cumulative_pv.toFixed(2)} USD present cost. Limit: not specified. No acceptance limit is specified.`;
}
document.querySelectorAll('[data-point]').forEach(point => {
  ['pointerenter', 'focus', 'click'].forEach(event => point.addEventListener(event, () => describePoint(Number(point.dataset.point))));
});
function renderComments() {
  const list = document.getElementById('comment-list');
  list.replaceChildren();
  comments.forEach(comment => {
    const item = document.createElement('li');
    item.textContent = `${comment.section}: ${comment.quote ? '“' + comment.quote + '” — ' : ''}${comment.text}`;
    list.appendChild(item);
  });
}
let selectedQuote = '';
document.querySelector('main').addEventListener('mouseup', () => { selectedQuote = window.getSelection().toString().trim(); });
document.getElementById('add-comment').addEventListener('click', () => {
  const text = document.getElementById('comment-text').value.trim();
  if (!text) { document.getElementById('comment-status').textContent = 'Enter a comment before adding it.'; return; }
  comments.push({section: document.getElementById('comment-section').value, quote: selectedQuote, text});
  document.getElementById('comment-text').value = '';
  selectedQuote = '';
  renderComments();
  document.getElementById('comment-status').textContent = 'Comment added. Save the comment file to keep it.';
});
function commentDocument() { return {revision: reportData.revision, report_digest: reportDigest, comments}; }
document.getElementById('save-comments').addEventListener('click', async () => {
  const text = JSON.stringify(commentDocument(), null, 2) + '\n';
  const status = document.getElementById('comment-status');
  try {
    if ('showSaveFilePicker' in window) {
      const handle = await window.showSaveFilePicker({suggestedName: 'report.comments.json', types: [{description: 'Comment file', accept: {'application/json': ['.json']}}]});
      const writable = await handle.createWritable();
      await writable.write(text); await writable.close();
      status.textContent = 'Comment file saved to the selected location.';
    } else {
      const url = URL.createObjectURL(new Blob([text], {type: 'application/json'}));
      const link = document.createElement('a'); link.href = url; link.download = 'report.comments.json'; link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      status.textContent = 'Comment file downloaded. Move it from Downloads beside this HTML document.';
    }
  } catch (error) { status.textContent = error.name === 'AbortError' ? 'Save cancelled; comments remain in this page.' : 'The file was not saved. ' + error.message; }
});
document.getElementById('load-comments').addEventListener('change', async event => {
  const status = document.getElementById('comment-status');
  try {
    const file = event.target.files[0]; if (!file) return;
    const saved = JSON.parse(await file.text());
    if (saved.report_digest !== reportDigest || saved.revision !== reportData.revision) throw new Error('The comment file belongs to another report revision.');
    if (!Array.isArray(saved.comments) || !saved.comments.every(item => /^s(?:[1-9]|10)$/.test(item.section) && typeof item.text === 'string' && typeof item.quote === 'string')) throw new Error('The comment file format is invalid.');
    comments.splice(0, comments.length, ...saved.comments); renderComments();
    status.textContent = 'Comments loaded for this report revision.';
  } catch (error) { status.textContent = 'Comments were not loaded. ' + error.message; }
});
</script>
</body>
</html>
